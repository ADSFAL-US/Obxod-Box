# ════════════════════════════════════════════════════════════════════
# .buildignore — что НЕ копируется в build/release-vX.Y.Z
#
# Синтаксис — упрощённый gitignore (см. mkbuild.ps1 → Convert-GitignorePattern).
# Поддерживается: #, пустые строки, ведущий "/", завершающий "/",
# "*", "**", "?", префикс "!" (отмена исключения).
# ════════════════════════════════════════════════════════════════════

# ── Python / venv / байткод ─────────────────────────────────────────
/.venv/
/venv/
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Git / IDE ───────────────────────────────────────────────────────
/.git/
/.gitattributes
/.gitignore
/.idea/
/.vscode/
/.vs/
/.editorconfig

# ── Артефакты сборки ────────────────────────────────────────────────
/build/
/build-bundle/
*.zip

# ── Рантайм-данные (скачивается/создаётся при первом запуске) ───────
/bin/
/geo/
/logs/

# ── Персональные данные пользователя ────────────────────────────────
/cfg/app-config.json
/cfg/x-ray_conf.json
/cfg/providers/

# ── Пресеты маршрутизации ───────────────────────────────────────────
/cfg/routing/*.json
!/cfg/routing/RU-auto-routing.json

# ── Инструменты сборки ──────────────────────────────────────────────
/mkbuild.ps1
/.buildignore

# ── Мусор ОС ────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store

# ── Локальный рантайм (создаётся при первом запуске) ───────────────
/runtime/

# ── 7z Олега Щербакова (для сборки установщика)
7zsd_extra.7z